From 4491192407abd877bee707270b2973a69215dd27 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 28 Jul 2026 15:19:11 +0200
Subject: [PATCH] Add Bybit and OKX account switcher

---
 web/app.py               |  19 +++++
 web/static/css/style.css | 172 +++++++++++++++++++++++++++++++++++++++
 web/templates/index.html |  59 +++++++++++++-
 3 files changed, 247 insertions(+), 3 deletions(-)

diff --git a/web/app.py b/web/app.py
index f50ff73..00ce55a 100644
--- a/web/app.py
+++ b/web/app.py
@@ -166,6 +166,11 @@ def _normalize_symbol(value):
     return normalized if normalized in SUPPORTED_SYMBOLS else "BTCUSDT"
 
 
+def _normalize_exchange(value):
+    normalized = str(value or "bybit").strip().lower()
+    return normalized if normalized in {"bybit", "okx"} else "bybit"
+
+
 def _get_cached_strategy(strategy_name="swing", symbol="BTCUSDT"):
     strategy_name = _normalize_strategy_name(strategy_name)
     symbol = _normalize_symbol(symbol)
@@ -239,6 +244,9 @@ def _get_cached_candles(timeframe, symbol="BTCUSDT"):
 @app.route("/")
 def home():
     symbol = _normalize_symbol(request.args.get("symbol", "BTCUSDT"))
+    active_exchange = _normalize_exchange(
+        request.args.get("exchange", "bybit")
+    )
     asset_info = SUPPORTED_SYMBOLS[symbol]
     strategy_name = _normalize_strategy_name(
         request.args.get("strategy", "swing")
@@ -291,6 +299,14 @@ def home():
         },
     }
     trade_data_error = None
+    okx_account = None
+    okx_account_error = None
+
+    if active_exchange == "okx":
+        try:
+            okx_account = OkxReadOnlyClient().connection_status()
+        except Exception as exc:
+            okx_account_error = str(exc)
 
     try:
         current_price = result["price"] if result else None
@@ -368,6 +384,7 @@ def home():
         "index.html",
         result=result,
         active_symbol=symbol,
+        active_exchange=active_exchange,
         asset_info=asset_info,
         supported_symbols=SUPPORTED_SYMBOLS.values(),
         active_strategy=strategy_name,
@@ -392,6 +409,8 @@ def home():
         order_cancelled=request.args.get("order_cancelled") == "1",
         order_fill_error=request.args.get("order_fill_error"),
         trade_data_error=trade_data_error,
+        okx_account=okx_account,
+        okx_account_error=okx_account_error,
         error=error,
     )
 
diff --git a/web/static/css/style.css b/web/static/css/style.css
index f5b0bed..d7ea867 100644
--- a/web/static/css/style.css
+++ b/web/static/css/style.css
@@ -45,6 +45,152 @@ h1 {
     gap: 8px;
 }
 
+.exchange-control {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+}
+
+.switcher-label {
+    color: #64748b;
+    font-size: 11px;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+}
+
+.exchange-switcher {
+    display: inline-flex;
+    gap: 4px;
+    padding: 4px;
+    background: #080f1d;
+    border: 1px solid #334155;
+    border-radius: 11px;
+}
+
+.exchange-button {
+    min-width: 82px;
+    padding: 8px 15px;
+    color: #94a3b8;
+    font-size: 13px;
+    font-weight: 800;
+    text-align: center;
+    text-decoration: none;
+    border: 1px solid transparent;
+    border-radius: 7px;
+    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
+}
+
+.exchange-button:hover {
+    color: #f8fafc;
+    background: #1e293b;
+}
+
+.exchange-bybit.is-active {
+    color: #fff7ed;
+    background: #b45309;
+    border-color: #f59e0b;
+}
+
+.exchange-okx.is-active {
+    color: #f8fafc;
+    background: #334155;
+    border-color: #cbd5e1;
+}
+
+.exchange-account-bar {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 18px;
+    min-height: 62px;
+    margin: -8px 0 20px;
+    padding: 13px 16px;
+    background: #172033;
+    border: 1px solid #334155;
+    border-left-width: 4px;
+    border-radius: 11px;
+}
+
+.exchange-account-bybit {
+    border-left-color: #f59e0b;
+}
+
+.exchange-account-okx {
+    border-left-color: #e2e8f0;
+}
+
+.exchange-account-heading {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    flex: 0 0 auto;
+}
+
+.exchange-account-name {
+    font-size: 17px;
+    font-weight: 800;
+}
+
+.connection-badge {
+    padding: 5px 8px;
+    font-size: 11px;
+    font-weight: 700;
+    border-radius: 999px;
+}
+
+.connection-badge.is-connected {
+    color: #a7f3d0;
+    background: rgb(6 95 70 / 55%);
+}
+
+.connection-badge.is-error {
+    color: #fecaca;
+    background: rgb(127 29 29 / 55%);
+}
+
+.connection-badge.is-market {
+    color: #fde68a;
+    background: rgb(146 64 14 / 45%);
+}
+
+.exchange-account-note,
+.exchange-account-error {
+    margin: 0;
+    color: #94a3b8;
+    font-size: 13px;
+}
+
+.exchange-account-error {
+    color: #fca5a5;
+}
+
+.exchange-balances {
+    display: flex;
+    justify-content: flex-end;
+    flex-wrap: wrap;
+    gap: 8px;
+}
+
+.exchange-balance {
+    padding: 6px 9px;
+    color: #cbd5e1;
+    font-size: 12px;
+    background: #0f172a;
+    border: 1px solid #334155;
+    border-radius: 7px;
+}
+
+.exchange-balance strong {
+    margin-right: 5px;
+    color: #f8fafc;
+}
+
+.exchange-balance-empty {
+    color: #94a3b8;
+    font-size: 12px;
+}
+
 .asset-switcher {
     display: inline-flex;
     gap: 5px;
@@ -1684,6 +1830,32 @@ body.is-resizing-column {
 }
 
 @media (max-width: 700px) {
+    .exchange-control,
+    .exchange-account-bar {
+        width: 100%;
+    }
+
+    .exchange-control {
+        justify-content: space-between;
+    }
+
+    .exchange-switcher {
+        flex: 1;
+    }
+
+    .exchange-button {
+        flex: 1;
+    }
+
+    .exchange-account-bar {
+        align-items: flex-start;
+        flex-direction: column;
+    }
+
+    .exchange-balances {
+        justify-content: flex-start;
+    }
+
     .whale-heading {
         flex-direction: column;
     }
diff --git a/web/templates/index.html b/web/templates/index.html
index 3228c33..248b31d 100644
--- a/web/templates/index.html
+++ b/web/templates/index.html
@@ -21,11 +21,28 @@
             </div>
 
             <div class="dashboard-switchers">
+                <div class="exchange-control">
+                    <span class="switcher-label">Аккаунт биржи</span>
+                    <nav class="exchange-switcher" aria-label="Выбор биржи">
+                        <a
+                            class="exchange-button exchange-bybit {{ 'is-active' if active_exchange == 'bybit' else '' }}"
+                            href="{{ url_for('home', symbol=active_symbol, strategy=active_strategy, exchange='bybit') }}"
+                        >
+                            Bybit
+                        </a>
+                        <a
+                            class="exchange-button exchange-okx {{ 'is-active' if active_exchange == 'okx' else '' }}"
+                            href="{{ url_for('home', symbol=active_symbol, strategy=active_strategy, exchange='okx') }}"
+                        >
+                            OKX
+                        </a>
+                    </nav>
+                </div>
                 <nav class="asset-switcher" aria-label="Выбор валюты">
                     {% for asset in supported_symbols %}
                         <a
                             class="asset-button {{ 'is-active' if asset['symbol'] == active_symbol else '' }}"
-                            href="{{ url_for('home', symbol=asset['symbol'], strategy=active_strategy) }}"
+                            href="{{ url_for('home', symbol=asset['symbol'], strategy=active_strategy, exchange=active_exchange) }}"
                         >
                             {{ asset["icon"] }} {{ asset["asset"] }}
                         </a>
@@ -35,14 +52,14 @@
             <nav class="strategy-switcher" aria-label="Выбор стратегии">
                 <a
                     class="strategy-button {{ 'is-active' if active_strategy == 'swing' else '' }}"
-                    href="{{ url_for('home', symbol=active_symbol, strategy='swing') }}"
+                    href="{{ url_for('home', symbol=active_symbol, strategy='swing', exchange=active_exchange) }}"
                 >
                     Swing
                     <small>1D + 4H</small>
                 </a>
                 <a
                     class="strategy-button strategy-fast {{ 'is-active' if active_strategy == 'fast' else '' }}"
-                    href="{{ url_for('home', symbol=active_symbol, strategy='fast') }}"
+                    href="{{ url_for('home', symbol=active_symbol, strategy='fast', exchange=active_exchange) }}"
                 >
                     Fast
                     <small>4H + 1H · тест</small>
@@ -51,6 +68,42 @@
             </div>
         </div>
 
+        <section class="exchange-account-bar exchange-account-{{ active_exchange }}">
+            <div class="exchange-account-heading">
+                <span class="exchange-account-name">
+                    {{ "OKX" if active_exchange == "okx" else "Bybit" }}
+                </span>
+                {% if active_exchange == "okx" and okx_account and okx_account["connected"] %}
+                    <span class="connection-badge is-connected">Подключено · только чтение</span>
+                {% elif active_exchange == "okx" %}
+                    <span class="connection-badge is-error">Нет соединения</span>
+                {% else %}
+                    <span class="connection-badge is-market">Основная биржа</span>
+                {% endif %}
+            </div>
+
+            {% if active_exchange == "okx" %}
+                {% if okx_account_error %}
+                    <p class="exchange-account-error">{{ okx_account_error }}</p>
+                {% elif okx_account %}
+                    <div class="exchange-balances">
+                        {% for balance in okx_account["currencies"] %}
+                            <span class="exchange-balance">
+                                <strong>{{ balance["currency"] }}</strong>
+                                {{ "{:,.8f}".format(balance["total"]).rstrip("0").rstrip(".") }}
+                            </span>
+                        {% else %}
+                            <span class="exchange-balance-empty">Ненулевые балансы не найдены</span>
+                        {% endfor %}
+                    </div>
+                {% endif %}
+            {% else %}
+                <p class="exchange-account-note">
+                    Анализ рынка и текущая история Bybit остаются без изменений.
+                </p>
+            {% endif %}
+        </section>
+
         {% if error %}
             <div class="error">
                 Ошибка анализа: {{ error }}
-- 
2.54.0.windows.1

